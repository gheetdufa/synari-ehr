# Application settings for the api and worker containers. Database, URLs and LiveKit are
# wired in docker-compose.yml from .env; everything else lives here.

# Required: openssl rand -hex 32
SECRET_KEY=
# Encrypts clinical text, identifiers and tokens at rest (required in production).
# Comma-separated key_id:base64(32 random bytes); the first key encrypts, all decrypt.
# Generate: echo "k1:$(openssl rand -base64 32)"
# Back this up separately from the database: without it the data can't be read.
DATA_ENCRYPTION_KEYS=

# Turn off after you've created your account(s)
ALLOW_REGISTRATION=true

# Scaling (see README.md "Scaling"): API processes, and database connections per process
WEB_CONCURRENCY=1
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
# Sign-in security. Unset: each practice decides whether staff need two-factor authentication
# (required by default); true/false forces it on/off for every practice.
REQUIRE_STAFF_MFA=
# Refuse staff passwords found in known breaches (Have I Been Pwned k-anonymity range API).
PASSWORD_BREACH_CHECK=true
# Where server-wide security alerts (backups, audit log checks) are emailed. Practice alerts go
# to each practice's owners, and so do server-wide ones when the server hosts one practice.
SECURITY_ALERT_EMAIL=

# Email (required for client sign-in links, reminders and notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Your Practice <no-reply@example.com>

# Optional: SMS reminders (Twilio). Incoming-message webhook: https://<SYNARI_DOMAIN>/api/webhooks/twilio/sms
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Optional: card payments (Stripe). Webhook: https://<SYNARI_DOMAIN>/api/webhooks/stripe
# Events: checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Insurance claims clearinghouse (optional; see deploy/README.md "Insurance claims")
STEDI_API_KEY=
STEDI_USAGE=T

# Optional: calendar sync with Google Calendar and Outlook (see README.md "Calendar sync").
# Redirect URIs: https://<SYNARI_DOMAIN>/api/calendar-sync/google/callback and .../microsoft/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common
CALENDAR_SYNC_INTERVAL_SECONDS=300

# Optional: store files in S3-compatible storage instead of the local volume. Files are always
# encrypted by Synari first; S3_SSE adds the bucket's encryption (AES256 or aws:kms with
# S3_KMS_KEY_ID, or the bucket's default KMS key when empty).
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
S3_KMS_KEY_ID=

# Backups (README.md "Backups"): a directory in the backup container, or s3://bucket/prefix
# (uses the S3_* credentials above; prefer a separate bucket with versioning or object lock).
# Encrypted to the age public keys below; keep the matching private key OFF this server.
BACKUP_TARGET=/backups
BACKUP_RETENTION_COUNT=14
AGE_RECIPIENTS=

# Largest file the SimplePractice importer accepts (exports are streamed to storage).
IMPORT_MAX_BYTES=2147483648

# Optional: AI documentation assistant. Only with a provider you have a BAA with.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
