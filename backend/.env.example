# Copy to backend/.env for local development. Every integration below is optional except
# DATABASE_URL and SECRET_KEY; features turn themselves off when their keys are empty.

ENVIRONMENT=development            # development | production
SECRET_KEY=                        # required in production: openssl rand -hex 32
# Encrypts clinical text, identifiers and tokens at rest (required in production).
# Comma-separated key_id:base64(32 random bytes); the first key encrypts, all decrypt.
# Generate: echo "k1:$(openssl rand -base64 32)"
# Back this up separately from the database: without it the data can't be read.
DATA_ENCRYPTION_KEYS=
DATABASE_URL=postgresql+psycopg://synari:synari@localhost:5432/synari
# Connections per process (each API worker and the background worker has its own pool):
# kept open, opened on top under load, and seconds a request waits for one.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
FRONTEND_URL=http://localhost:5173 # used in email links and CORS
CORS_ORIGINS=http://localhost:5173
ALLOW_REGISTRATION=true            # set false after creating your account(s)

# Email: any SMTP provider. Local dev uses Mailpit from docker compose (UI: http://localhost:8025)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURITY=none                 # starttls | ssl | none
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Synari <no-reply@synari.local>

# SMS appointment reminders (Twilio). Point the number's incoming-message webhook at
# https://<your-api-host>/api/webhooks/twilio/sms so STOP/START opt-outs are honored.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Online card payments (Stripe). Use test keys (sk_test_...) until you're live.
# In the Stripe dashboard add a webhook to https://<your-api-host>/api/webhooks/stripe for:
#   checkout.session.completed, payment_intent.succeeded, payment_intent.payment_failed,
#   charge.refunded — and paste its signing secret below.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# Telehealth video (LiveKit). Local dev uses the LiveKit dev server from docker compose.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# File storage: local | s3 (any S3-compatible service). Every file is encrypted with its own
# key (wrapped by DATA_ENCRYPTION_KEYS) before it's stored; S3_SSE adds the bucket's own
# encryption on top: AES256 | aws:kms (with S3_KMS_KEY_ID, or the bucket's default KMS key).
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/files
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_SSE=AES256
S3_KMS_KEY_ID=

# Backups: `python -m synari.admin backup` / `restore-test` (see deploy/README.md "Backups").
# BACKUP_TARGET is a directory or s3://bucket/prefix; empty turns backups and their alerts off.
# Backups are encrypted to the AGE_RECIPIENTS public keys (age1..., comma separated); the
# restore test decrypts with AGE_IDENTITY_FILE (keep that private key off the server) and
# restores into a throwaway database on RESTORE_TEST_DATABASE_URL's server (default:
# DATABASE_URL's; needs CREATEDB).
BACKUP_TARGET=
BACKUP_RETENTION_COUNT=14
AGE_RECIPIENTS=
AGE_IDENTITY_FILE=
RESTORE_TEST_DATABASE_URL=

# Largest file the SimplePractice importer accepts (exports are streamed to storage).
IMPORT_MAX_BYTES=2147483648

# AI documentation assistant (optional). Only send session content to a provider you have a
# Business Associate Agreement with. Any OpenAI-compatible API works via OPENAI_BASE_URL.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=whisper-1

# Insurance claims clearinghouse (Stedi, optional). With a key, claims can be sent
# electronically, acknowledgments (277CA) and payments (835 ERAs) come back automatically, and
# eligibility can be checked. Without one, download 837P files or print CMS-1500 forms instead.
# Start with a test key and STEDI_USAGE=T; switch to a production key and P when you go live.
STEDI_API_KEY=
STEDI_BASE_URL=https://healthcare.us.stedi.com
STEDI_USAGE=T                      # T test claims | P production claims

# Calendar sync with Google Calendar and Outlook/Microsoft 365 (optional; see deploy/README.md
# "Calendar sync"). Each provider turns on when its client id and secret are set. Register these
# OAuth redirect URIs exactly:
#   {PUBLIC_API_URL}/api/calendar-sync/google/callback
#   {PUBLIC_API_URL}/api/calendar-sync/microsoft/callback
# PUBLIC_API_URL is where browsers reach the API, without /api (defaults to FRONTEND_URL, right
# when the API is served at /api on the app's domain). Tokens are encrypted with
# DATA_ENCRYPTION_KEYS.
PUBLIC_API_URL=http://localhost:8000
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_TENANT=common      # common (work, school and personal accounts) or your tenant id
CALENDAR_SYNC_INTERVAL_SECONDS=300 # how often busy times are re-read from each calendar
# Audit log: the worker seals events into tamper-evident hash chains and purges them after
# this many years (at least 6, the HIPAA minimum). Verify by hand: python -m synari.admin audit-verify
AUDIT_RETENTION_YEARS=6
# Sign-in security
# Leave REQUIRE_STAFF_MFA unset to let each practice decide (two-factor is required by default);
# true requires it for every practice, false turns the requirement off everywhere.
REQUIRE_STAFF_MFA=
STAFF_SESSION_HOURS=12             # staff sign in again after this long (idle limit: practice setting)
PORTAL_IDLE_MINUTES=30             # client-portal sessions end after this much inactivity
PORTAL_SESSION_DAYS=7              # ...and this long after sign-in
# Refuse staff passwords found in known breaches (Have I Been Pwned; only 5 characters of the
# password's SHA-1 hash are sent). If the service can't be reached, the check is skipped.
PASSWORD_BREACH_CHECK=false
SECURITY_ALERT_CLIENTS_PER_HOUR=50 # flag anyone who opens more clients than this in an hour
# Server-wide security alerts (backups, audit log checks) are emailed here; when the server
# hosts a single practice they also reach its owners in the app.
SECURITY_ALERT_EMAIL=

# Background worker
WORKER_INTERVAL_SECONDS=30
RUN_WORKER_IN_API=false            # true runs the worker inside the API process (single-server installs)
