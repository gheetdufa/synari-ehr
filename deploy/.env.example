# Domains (DNS A records must point at this server before starting)
SYNARI_DOMAIN=app.example.com
LIVEKIT_DOMAIN=video.example.com

# Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# Optional: the Docker network and Caddy's fixed address on it. The API only trusts forwarded
# client IPs from CADDY_IP. Change both if 172.30.0.0/24 collides with a network on this host.
# SYNARI_SUBNET=172.30.0.0/24
# CADDY_IP=172.30.0.10

# LiveKit credentials shared by the API and the LiveKit server.
# Key: any short id (e.g. synari). Secret: openssl rand -hex 32
LIVEKIT_API_KEY=synari
LIVEKIT_API_SECRET=

# Optional services: set to "backup" once backups are configured (see README.md "Backups")
COMPOSE_PROFILES=
